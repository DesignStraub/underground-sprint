; Engine configuration file.
config_version=5

[application]

config/name="Need for Geschwindigkeit"
run/main_scene="res://scenes/intro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/game_state.gd"
Music="*res://scripts/music.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/D-DIN-Bold.otf"

[internationalization]

locale/fallback="de"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_renderable_lights=256
limits/opengl/max_lights_per_object=16
textures/vram_compression/import_etc2_astc=true
