static var _added := false


static func setup(lang: String) -> void:
	if not _added:
		var t := Translation.new()
		t.locale = "en"
		for k in EN:
			t.add_message(k, EN[k])
		TranslationServer.add_translation(t)
		_added = true
	TranslationServer.set_locale(lang if lang in LANGS else "en")
