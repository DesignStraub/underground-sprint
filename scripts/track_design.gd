# --- Planung ------------------------------------------------------------------------------------------------------------

## Mittellinie aus den Stützpunkten; Rundkurse schließen mit dem ersten Punkt (wie _loop_centerline)
static func centerline(race: Dictionary) -> Dictionary:
	var lay: Dictionary = LAYOUTS[race["layout"]]
	var pts := []
	for p in lay["pts"]:
		pts.append(Vector3(p[0], 0.0, p[1]))
	if race.get("type", "") in ["circuit", "drift"]:
		pts.append(pts[0])
	# Abkürzungen der Sprints wie bei _centerline: die Hauptstraße macht von p0 über p1 nach p2 einen Bogen, die Sehne
	# p0–p2 wird zur Gasse, zum Seedamm oder zur Gabelung (_plan_shortcut). [Art, Stützpunkt p0, p1, p2]
	var bulges := []
	for bl in lay.get("bulges", []):
		var p0: Vector3 = pts[bl[1]]
		var p2: Vector3 = pts[bl[3]]
		var ch := p2 - p0
		bulges.append({"kind": bl[0], "p0": p0, "p1": pts[bl[2]], "p2": p2, "heading": atan2(-ch.x, -ch.z), "a": ch.length()})
	return {"pts": pts, "bulges": bulges, "k": lay.get("k", 0.17)}


## Nach dem Bau der Kurve: Höhenprofil, Felstunnel, Berg (Gitter kommt erst beim Bauen, wenn die Ausfahrten stehen)
static func plan(track: Dictionary, race: Dictionary) -> void:
	var lay: Dictionary = LAYOUTS[race["layout"]]
	var curve: Curve3D = track["curve"]
	var L: float = track["length"]
	var offs := PackedFloat32Array()
	var hs := PackedFloat32Array()
	for i in lay["pts"].size():
		var p: Array = lay["pts"][i]
		var o := 0.0 if i == 0 else curve.get_closest_offset(Vector3(p[0], 0.0, p[1]))
		if i > 0 and o <= offs[i - 1]:
			o = offs[i - 1] + 1.0  # Sicherheit: streng steigend
		offs.append(o)
		hs.append(float(p[2]))
	if track["loop"]:
		offs.append(L)
		hs.append(hs[0])
	track["ctrl_offs"] = offs
	var prof := PackedFloat32Array()
	var m := _tangents(offs, hs)
	var n := int(ceil(L / PROF_STEP)) + 2
	for i in n:
		prof.append(_hermite(offs, hs, m, minf(i * PROF_STEP, L)))
	curve.set_meta("prof", prof)
	if lay.has("tunnel"):
		var a: float = offs[lay["tunnel"][0]]
		var b: float = offs[lay["tunnel"][1]]
		track["tunnels"].append({"from": a, "to": b, "name": lay.get("tunnel_name", "TUNNEL"), "sodium": true, "r0": a, "r1": b,
			"rock": true})
	track["design"] = lay
	# Hochstraßen, Brücken und Parkdecks: [Stützpunkt von, bis, Bauart] ("bridge" Pfeiler, "cable" Schrägseilbrücke mit
	# Pylonen, "deck" Parkhaus darunter); dort keine Grasböschung, sondern das Bauwerk (build_step1)
	for hv in lay.get("hochstrassen", []):
		if not track.has("hochstrassen"):
			track["hochstrassen"] = []
		track["hochstrassen"].append({"from": offs[hv[0]], "to": offs[hv[1]], "style": hv[2] if hv.size() > 2 else "bridge",
			"name": hv[3] if hv.size() > 3 else "", "gleise": hv[4] if hv.size() > 4 else 0})
	if lay.get("mountain", false):
		track["mountain"] = lay
		track["terrain_lay"] = lay
	else:
		_plan_town(track, lay, offs)
		if lay.has("hill"):
			track["terrain_lay"] = lay  # Hang mit Weinbergen und Wald (Stuttgart): Gitter nur im Rechteck "hill"


## Stadt-Entwurf: Viertel in fester Folge (je 400 m), Fluss mit Ufermauern (wie bei den Orts-Strecken, Brücken dort,
## wo die Hauptstraße ihn quert), Tunnel und Bahnübergang an festen Stellen statt zufällig
static func _plan_town(track: Dictionary, lay: Dictionary, offs: PackedFloat32Array) -> void:
	# Wo die Straße am Hang liegt, keine Sackgassen, Nebenstraßen, Mittelstreifen, Bahnübergänge (die gingen ebenerdig
	# vom erhöhten Schenkel ab): als Zonen sperren
	var tcurve: Curve3D = track["curve"]
	var tlen: float = track["length"]
	var up0 := -1.0
	var du := 0.0
	while du <= tlen:
		var up := absf(Track.elev_at(tcurve, du)) > 0.05
		if up and up0 < 0.0:
			up0 = du
		elif not up and up0 >= 0.0:
			track["zones"].append({"from": up0 - 15.0, "to": du + 15.0})
			up0 = -1.0
		du += 5.0
	if up0 >= 0.0:
		track["zones"].append({"from": up0 - 15.0, "to": tlen + 15.0})
	if lay.has("districts"):
		var seq: Array = lay["districts"]
		var arr: Array = track["districts"]
		for k in arr.size():
			arr[k] = seq[mini(k, seq.size() - 1)]
	# Mittelstreifen und Hochbahn nur, wo der Entwurf sie will ("medians" von Hand, "generic_medians"/"el" für die
	# zufälligen aus track_builder); sonst lag etwa eine Mittelstreifen-Nase in der Kurve hinter dem Frankfurter Tunnel
	if not lay.get("generic_medians", false):
		track["fixed_medians"] = true
	if not lay.get("el", false):
		track["fixed_el"] = true
	if lay.has("rivers"):
		var keep: Dictionary = track["city"]
		track["city"] = {"rivers": lay["rivers"]}
		var nb: int = track["bridges"].size()
		Track._plan_rivers(track)
		track["city"] = keep
		track["river_nb"] = nb
	if lay.has("tunnels"):
		track["fixed_tunnels"] = true
		for tu in lay["tunnels"]:
			var a: float = offs[tu[0]]
			var b: float = offs[tu[1]]
			# [von, bis, Name, Natriumlicht, Tiefe]: unter einem Fluss tiefer (Decke unter dem Wasserspiegel), Rampen länger
			var dip: float = float(tu[4]) if tu.size() > 4 else Track.DIP
			var ramp: float = Track.DIP_RAMP * maxf(dip / Track.DIP, 1.0)
			var t := {"from": a, "to": b, "name": tu[2] if tu.size() > 2 else "TUNNEL", "sodium": tu.size() > 3 and tu[3],
				"r0": a - ramp, "r1": b + ramp}
			track["tunnels"].append(t)
			track["zones"].append({"from": t["r0"] - 18.0, "to": t["r1"] + 18.0})
			track["elev0"].append({"a": t["r0"], "b": a + 4.0, "c": b - 4.0, "e": t["r1"], "h": -dip})
	if track.has("river_nb"):
		_river_bridges(track, track["river_nb"])
		track.erase("river_nb")
		# über Wasser auf einer Hochstraße: die flache Steinbrücke darunter entfällt (die Hochstraße hat eigene Pfeiler)
		track["bridges"] = track["bridges"].filter(func(b): return not _in_hochstrasse(track, b["d"]))
	if lay.has("crossing"):
		track["fixed_crossing"] = true
		if lay["crossing"] >= 0:
			Track._set_crossing(track, offs[lay["crossing"]])
	# feste Prachtalleen mit Mittelstreifen ("medians": Stützpunkt von–bis), vor den Sackgassen geplant (die meiden sie)
	for md in lay.get("medians", []):
		track["medians"].append({"from": offs[md[0]], "to": offs[md[1]]})
	# Schikanen und Kehren ("clear": Stützpunkt von–bis): dort keine Poller, Hydranten, Bänke am inneren Bordstein, über
	# den man die Kurve schneidet (der Autopilot krachte in Köln in der Schikane frontal in einen Hydranten)
	for cl in lay.get("clear", []):
		track["zones"].append({"from": offs[cl[0]] - 10.0, "to": offs[cl[1]] + 10.0, "clear": true})  # Einmündungen erlaubt
	# Einmündungen der Querstraßen (Open World) auch im Rennen freihalten: kein Mittelstreifen, keine Sackgasse,
	# kein Tunnel dort; so liegen Mittelstreifen und Abzweige im Rennen und in der Welt gleich
	for cr in lay.get("cross", []):
		for i in [cr[0], cr[1]]:
			track["zones"].append({"from": offs[i] - 26.0, "to": offs[i] + 26.0})
	_plan_gleisfeld(track)


## Gleisfeld unter einer Hochstraße (Dortmund): Gleise quer unter der Mitte des hohen Abschnitts, dort keine Pfeiler,
## keine Häuser, keine Nebenstraßen; entlang des ganzen hohen Abschnitts bleibt es neben der Brücke frei (sonst stünden
## die Häuser auf dunklen Sockeln in Fahrbahnhöhe daneben)
static func _plan_gleisfeld(track: Dictionary) -> void:
	var tcurve: Curve3D = track["curve"]
	for v in track.get("hochstrassen", []):
		if int(v["gleise"]) <= 0:
			continue
		var ymax := 0.0
		var dd: float = v["from"]
		while dd < v["to"]:
			ymax = maxf(ymax, Track.elev_at(tcurve, dd))
			dd += 4.0
		var top0 := -1.0
		var top1 := -1.0
		dd = v["from"]
		while dd < v["to"]:
			if Track.elev_at(tcurve, dd) > ymax - 1.5:
				if top0 < 0.0:
					top0 = dd
				top1 = dd
			dd += 4.0
		var dm := (top0 + top1) / 2.0
		var half_span: float = int(v["gleise"]) * GLEIS_STEP / 2.0 + 4.0
		v["gleis_d"] = dm
		v["gleis_half"] = half_span
		var f := Track.frame_at(tcurve, dm)
		var kos := []
		var a := -GLEIS_LEN
		while a <= GLEIS_LEN + 0.1:
			var b := -half_span + 8.0
			while b <= half_span - 7.9:
				kos.append({"pos": f["pos"] + f["right"] * a + f["fwd"] * b, "r": 9.0})
				b += 12.0
			a += 12.0
		track["keepout"] = track["keepout"] + kos  # eigene Kopie: das Array der Welt (race["keepout"]) bleibt unberührt
		# frei neben der Brücke über den ganzen hohen Abschnitt
		var occ := kos.duplicate()
		dd = top0 - 30.0
		while dd <= top1 + 30.0:
			var fd := Track.frame_at(tcurve, dd)
			var edge: float = Track.hw(track, dd) + Track.WALK
			for sd in [-1.0, 1.0]:
				for off in [edge + 9.0, edge + 26.0]:
					occ.append({"pos": fd["pos"] + fd["right"] * sd * off, "r": 10.0})
			dd += 14.0
		v["gleis_occ"] = occ


## Flussbrücken aus der Straße selbst: _plan_rivers schätzt eine Querung zwischen zwei Flusspunkten; liegen deren
## nächste Straßenstellen auf verschiedenen Schenkeln (Nürnberg: Burgberg-Schenkel und Henkersteg-Schleife), landet die
## Brücke im Trockenen und die echte Querung fehlt. Hier gilt: wo die Mittellinie über Wasser liegt, steht eine Brücke.
static func _river_bridges(track: Dictionary, n0: int) -> void:
	var curve: Curve3D = track["curve"]
	var tlen: float = track["length"]
	var wet_spans := []
	var a := -1.0
	var d := 0.0
	while d <= tlen + 2.0:
		var wet := d <= tlen and Track._river_clearance(track, curve.sample_baked(minf(d, tlen))) < 0.0
		if wet and a < 0.0:
			a = d
		elif not wet and a >= 0.0:
			wet_spans.append([a, d])
			a = -1.0
		d += 2.0
	var planned: Array = track["bridges"].slice(n0)
	var out: Array = track["bridges"].slice(0, n0)
	for sp in wet_spans:
		var dc: float = (sp[0] + sp[1]) / 2.0
		if not Track.tunnel_at(track, dc).is_empty():
			continue  # Flusstunnel (Rostock): die Straße liegt tief unter dem Wasser
		var b := {}
		for pb in planned:
			if pb["d0"] < sp[0] and pb["d1"] > sp[1]:
				b = pb
		if b.is_empty():
			# Fluss und Richtung an der Querung: nächster Flussabschnitt
			var f := Track.frame_at(curve, dc)
			var p2 := Vector2(f["pos"].x, f["pos"].z)
			var best := 1e9
			var half := 15.0
			var rdir := Vector2.RIGHT
			for rv in track["rivers"]:
				var pts: PackedVector2Array = rv["pts"]
				for i in pts.size() - 1:
					var ab := pts[i + 1] - pts[i]
					var t := clampf((p2 - pts[i]).dot(ab) / maxf(ab.length_squared(), 0.001), 0.0, 1.0)
					var dist := p2.distance_to(pts[i] + ab * t)
					if dist < best:
						best = dist
						half = rv["half"]
						rdir = ab.normalized()
			var sn := maxf(absf(rdir.dot(Vector2(f["right"].x, f["right"].z))), 0.35)
			var reach := maxf((half + 12.0) / sn, (sp[1] - sp[0]) / 2.0 + 8.0)
			b = {"d": dc, "d0": dc - reach, "d1": dc + reach, "half": half}
			track["zones"].append({"from": dc - reach - 15.0, "to": dc + reach + 15.0})
		if not out.has(b):
			out.append(b)
	for pb in planned:
		if not out.has(pb):
			track["zones"] = track["zones"].filter(func(z): return not (z["from"] == pb["d0"] - 15.0 and z["to"] == pb["d1"] + 15.0))
	track["bridges"] = out


## Tangenten der monotonen kubischen Interpolation (Fritsch-Carlson): an Hoch- und Tiefpunkten flach, sonst gewichtetes
## Mittel der Nachbarsteigungen
static func _tangents(xs: PackedFloat32Array, ys: PackedFloat32Array) -> PackedFloat32Array:
	var n := xs.size()
	var dk := PackedFloat32Array()
	for i in n - 1:
		dk.append((ys[i + 1] - ys[i]) / maxf(xs[i + 1] - xs[i], 0.01))
	var m := PackedFloat32Array()
	m.resize(n)
	m[0] = dk[0]
	m[n - 1] = dk[n - 2]
	for i in range(1, n - 1):
		if dk[i - 1] * dk[i] <= 0.0:
			m[i] = 0.0
		else:
			var w1 := 2.0 * (xs[i + 1] - xs[i]) + (xs[i] - xs[i - 1])
			var w2 := (xs[i + 1] - xs[i]) + 2.0 * (xs[i] - xs[i - 1])
			m[i] = (w1 + w2) / (w1 / dk[i - 1] + w2 / dk[i])
	return m


static func _hermite(xs: PackedFloat32Array, ys: PackedFloat32Array, m: PackedFloat32Array, x: float) -> float:
	var hi := xs.size() - 1
	if x <= xs[0]:
		return ys[0]
	if x >= xs[hi]:
		return ys[hi]
	var lo := 0
	while hi - lo > 1:
		var mid := (lo + hi) / 2
		if xs[mid] <= x:
			lo = mid
		else:
			hi = mid
	var h := xs[hi] - xs[lo]
	var t := (x - xs[lo]) / h
	var t2 := t * t
	var t3 := t2 * t
	return (2.0 * t3 - 3.0 * t2 + 1.0) * ys[lo] + (t3 - 2.0 * t2 + t) * h * m[lo] + (-2.0 * t3 + 3.0 * t2) * ys[hi] \
		+ (t3 - t2) * h * m[hi]


static func in_rock_tunnel(track: Dictionary, d: float, margin := 0.0) -> bool:
	for t in track["tunnels"]:
		if t.get("rock", false) and d > t["from"] - margin and d < t["to"] + margin:
			return true
	return false


# --- Berg: Höhengitter --------------------------------------------------------------------------------------------------

## Höhengitter des Bergs: für jede Zelle untere und obere Grenze aus allen Straßen (Fahrbahnhöhe am Rand, Felswand und
## Böschung davon weg), dazwischen die natürliche Form. Die obere Grenze gewinnt: keine Straße liegt je unter dem Berg
## (im Felstunnel umgekehrt: dort muss der Fels über der Röhre bleiben).
static func _plan_terrain(track: Dictionary) -> void:
	var lay: Dictionary = track["terrain_lay"]
	var lo2 := Vector2(1e9, 1e9)
	var hi2 := Vector2(-1e9, -1e9)
	if lay.has("hill"):
		var hr: Array = lay["hill"]
		lo2 = Vector2(hr[0], hr[1])
		hi2 = Vector2(hr[2], hr[3])
	else:
		for p in track["paths"]:
			for q in (p["curve"] as Curve3D).get_baked_points():
				lo2 = lo2.min(Vector2(q.x, q.z))
				hi2 = hi2.max(Vector2(q.x, q.z))
		lo2 -= Vector2(MARGIN, MARGIN)
		hi2 += Vector2(MARGIN, MARGIN)
	var nx := int(ceil((hi2.x - lo2.x) / CELL)) + 1
	var nz := int(ceil((hi2.y - lo2.y) / CELL)) + 1
	var N := nx * nz
	var lo_b := PackedFloat32Array()
	lo_b.resize(N)
	lo_b.fill(-1e9)
	var hi_b := PackedFloat32Array()
	hi_b.resize(N)
	hi_b.fill(1e9)
	var near := PackedFloat32Array()  # Abstand zum nächsten Straßenrand (Bäume, Abfall nach außen)
	near.resize(N)
	near.fill(1e9)
	var samples := []  # [x, z, y] der Hauptstraße alle 8 m (natürliche Form)
	var reach := 64.0
	for p in track["paths"]:
		var c: Curve3D = p["curve"]
		var L := c.get_baked_length()
		var main: bool = p["id"] == 0
		var d := 0.0
		var k := 0
		while d <= L + 0.01:
			var f := Track.frame_at(c, d)
			var q: Vector3 = f["pos"]
			var y: float = f["y"]
			var edge: float = (Track.hw(track, d) + Track.WALK + 0.3) if main else (float(p["half_w"]) + 1.5)
			var tun: bool = main and in_rock_tunnel(track, d)
			if main and k % 2 == 0:
				samples.append(Vector3(q.x, y, q.z))
			var r := edge + reach
			var i0 := maxi(int(floor((q.x - r - lo2.x) / CELL)), 0)
			var i1 := mini(int(ceil((q.x + r - lo2.x) / CELL)), nx - 1)
			var j0 := maxi(int(floor((q.z - r - lo2.y) / CELL)), 0)
			var j1 := mini(int(ceil((q.z + r - lo2.y) / CELL)), nz - 1)
			for j in range(j0, j1 + 1):
				var cz := lo2.y + j * CELL - q.z
				for i in range(i0, i1 + 1):
					var cx := lo2.x + i * CELL - q.x
					var dist := sqrt(cx * cx + cz * cz)
					if dist > r:
						continue
					var s := dist - edge
					var idx := j * nx + i
					if s < near[idx]:
						near[idx] = s
					if tun:
						# Fels über der Röhre (die Decke liegt ROCK_TUN_H über der Fahrbahn)
						lo_b[idx] = maxf(lo_b[idx], y + ROCK_TUN_H + 3.0 - maxf(s, 0.0) * 1.2)
						continue
					if s < 0.0:
						hi_b[idx] = minf(hi_b[idx], y - 0.15)
						lo_b[idx] = maxf(lo_b[idx], y - 1.0)
					else:
						hi_b[idx] = minf(hi_b[idx], y - 0.15 + s * K_CUT)
						lo_b[idx] = maxf(lo_b[idx], y - 1.0 - s * K_FILL)
			d += 4.0
			k += 1
	# Plätze (Aussichtspunkt, Gasthof): eben auf ihrer Höhe, ringsum wie an einer Straße
	for pad in track.get("pads", []):
		var c: Vector2 = pad["c"]
		var u: Vector2 = pad["u"]
		var hu: float = pad["hu"]
		var hv: float = pad["hv"]
		var y: float = pad["y"]
		var r := maxf(hu, hv) + 40.0
		var i0 := maxi(int(floor((c.x - r - lo2.x) / CELL)), 0)
		var i1 := mini(int(ceil((c.x + r - lo2.x) / CELL)), nx - 1)
		var j0 := maxi(int(floor((c.y - r - lo2.y) / CELL)), 0)
		var j1 := mini(int(ceil((c.y + r - lo2.y) / CELL)), nz - 1)
		for j in range(j0, j1 + 1):
			for i in range(i0, i1 + 1):
				var w := Vector2(lo2.x + i * CELL, lo2.y + j * CELL) - c
				var a := absf(w.dot(u)) - hu
				var b := absf(w.dot(Vector2(-u.y, u.x))) - hv
				var s := Vector2(maxf(a, 0.0), maxf(b, 0.0)).length() + minf(maxf(a, b), 0.0)
				var idx := j * nx + i
				if s < 0.0:
					hi_b[idx] = minf(hi_b[idx], y - 0.1)
					lo_b[idx] = maxf(lo_b[idx], y - 0.3)
				elif s < 40.0:
					hi_b[idx] = minf(hi_b[idx], y - 0.1 + s * K_CUT)
					lo_b[idx] = maxf(lo_b[idx], y - 0.3 - s * K_FILL)
	# Open World: fremde Fahrbahnen (Ring, Auffahrten, Nachbarn) bleiben frei
	for ko in track["keepout"]:
		var kp: Vector3 = ko["pos"]
		var kr: float = float(ko["r"]) + 8.0
		var i0 := maxi(int(floor((kp.x - kr - 60.0 - lo2.x) / CELL)), 0)
		var i1 := mini(int(ceil((kp.x + kr + 60.0 - lo2.x) / CELL)), nx - 1)
		var j0 := maxi(int(floor((kp.z - kr - 60.0 - lo2.y) / CELL)), 0)
		var j1 := mini(int(ceil((kp.z + kr + 60.0 - lo2.y) / CELL)), nz - 1)
		for j in range(j0, j1 + 1):
			for i in range(i0, i1 + 1):
				var s := Vector2(lo2.x + i * CELL - kp.x, lo2.y + j * CELL - kp.z).length() - kr
				var idx := j * nx + i
				hi_b[idx] = minf(hi_b[idx], -0.4 + maxf(s, 0.0) * K_FILL)
	# natürliche Form: geglättete Straßenhöhen auf einem groben Gitter, innen ein Kern, außen fällt sie ab
	var poly := PackedVector2Array()
	for sp in samples:
		poly.append(Vector2(sp.x, sp.z))
	var cg := 25.0
	var cnx := int(ceil((hi2.x - lo2.x) / cg)) + 2
	var cnz := int(ceil((hi2.y - lo2.y) / cg)) + 2
	var coarse := PackedFloat32Array()
	coarse.resize(cnx * cnz)
	for j in cnz:
		for i in cnx:
			var px := lo2.x + i * cg
			var pz := lo2.y + j * cg
			var wsum := 0.0
			var hsum := 0.0
			for sp in samples:
				var dx: float = sp.x - px
				var dz: float = sp.z - pz
				var dd := dx * dx + dz * dz
				if dd > 260.0 * 260.0:
					continue
				var w := 1.0 / (dd + 900.0)
				wsum += w
				hsum += w * sp.y
			coarse[j * cnx + i] = hsum / wsum if wsum > 0.0 else 0.0
	var noise := FastNoiseLite.new()
	noise.seed = 1207
	noise.frequency = 1.0 / 70.0
	noise.fractal_octaves = 3
	var core: float = lay.get("core", 10.0)
	var h := PackedFloat32Array()
	h.resize(N)
	for j in nz:
		for i in nx:
			var px := lo2.x + i * CELL
			var pz := lo2.y + j * CELL
			var idx := j * nx + i
			var gx := (px - lo2.x) / cg
			var gz := (pz - lo2.y) / cg
			var ci := mini(int(gx), cnx - 2)
			var cj := mini(int(gz), cnz - 2)
			var fx := gx - ci
			var fz := gz - cj
			var base := lerpf(lerpf(coarse[cj * cnx + ci], coarse[cj * cnx + ci + 1], fx),
				lerpf(coarse[(cj + 1) * cnx + ci], coarse[(cj + 1) * cnx + ci + 1], fx), fz)
			var dn: float = near[idx]
			var pp := Vector2(px, pz)
			var inside := Geometry2D.is_point_in_polygon(pp, poly)
			var m: float
			if inside:
				m = base + core * smoothstep(0.0, 60.0, dn)
			else:
				m = base * (1.0 - smoothstep(0.0, 70.0, dn))
			for pk in lay.get("peaks", []):
				var dp := pp.distance_to(Vector2(pk[0], pk[1]))
				if dp < pk[3]:
					m = maxf(m, float(pk[2]) * (1.0 - smoothstep(0.0, 1.0, dp / pk[3])) * (0.85 + 0.15 * cos(dp * 0.05)))
			m += noise.get_noise_2d(px, pz) * 6.0 * clampf(m / 6.0, 0.0, 1.0)
			var v := minf(maxf(m, lo_b[idx]), hi_b[idx])
			# zum Rand des Gitters hin auf den Boden
			var edge_d := minf(minf(px - lo2.x, hi2.x - px), minf(pz - lo2.y, hi2.y - pz))
			v = lerpf(-0.4, v, smoothstep(0.0, 40.0, edge_d))
			h[idx] = v
	track["terrain"] = {"o": lo2, "nx": nx, "nz": nz, "h": h, "near": near}


## Höhe des Bergs an pos (Streckenkoordinaten), -1e9 außerhalb
static func terrain_h(track: Dictionary, pos: Vector3) -> float:
	var t: Dictionary = track.get("terrain", {})
	if t.is_empty():
		return -1e9
	var o: Vector2 = t["o"]
	var gx := (pos.x - o.x) / CELL
	var gz := (pos.z - o.y) / CELL
	var nx: int = t["nx"]
	var nz: int = t["nz"]
	if gx < 0.0 or gz < 0.0 or gx >= nx - 1 or gz >= nz - 1:
		return -1e9
	var i := int(gx)
	var j := int(gz)
	var fx := gx - i
	var fz := gz - j
	var h: PackedFloat32Array = t["h"]
	return lerpf(lerpf(h[j * nx + i], h[j * nx + i + 1], fx), lerpf(h[(j + 1) * nx + i], h[(j + 1) * nx + i + 1], fx), fz)


static var _mat: ShaderMaterial = null
static var _vine_mat: ShaderMaterial = null


## Berg-Material (geteilt); vine: Weinberg-Hang mit Rebzeilen und Trockenmauern (Stuttgart)
static func material(vine := false) -> ShaderMaterial:
	if vine:
		if _vine_mat == null:
			_vine_mat = ShaderMaterial.new()
			_vine_mat.shader = MOUNTAIN_SHADER
			_vine_mat.set_shader_parameter("vine", 1.0)
		return _vine_mat
	if _mat == null:
		_mat = ShaderMaterial.new()
		_mat.shader = MOUNTAIN_SHADER
	return _mat


static func set_daytime(day: float) -> void:
	for m in [_mat, _vine_mat]:
		if m != null:
			(m as ShaderMaterial).set_shader_parameter("day", day)


static func _in_hochstrasse(track: Dictionary, d: float, margin := 0.0) -> bool:
	for v in track.get("hochstrassen", []):
		if d > v["from"] - margin and d < v["to"] + margin:
			return true
	return false


## Keine Grasböschung unter der erhöhten Hauptstraße bei d: am Berg trägt das Gelände, auf Hochstraßen Pfeiler
static func no_bank(track: Dictionary, d: float, pos: Vector3) -> bool:
	return on_terrain(track, pos) or _in_hochstrasse(track, d, 2.0)


## Keine flachen Nebelschichten bei d (track_builder._build_mist): über Hängen und neben Hochstraßen lagen sie als helle
## Platte in der Luft (Stuttgarter Weinberg nachts)
static func no_mist(track: Dictionary, d: float) -> bool:
	if not track.has("design"):
		return false
	var f := Track.frame_at(track["curve"], d)
	return no_bank(track, d, f["pos"]) or absf(float(f["y"])) > 1.0


## Liegt pos auf dem Gelände eines Entwurfs (dort keine Grasböschung unter erhöhter Straße, das Gelände trägt sie)?
## Schon beim Straßenbau gefragt, bevor das Gitter steht: nur Planung
static func on_terrain(track: Dictionary, pos: Vector3) -> bool:
	if not track.has("terrain_lay"):
		return false
	var lay: Dictionary = track["terrain_lay"]
	if not lay.has("hill"):
		return true
	var hr: Array = lay["hill"]
	return pos.x > hr[0] + 30.0 and pos.x < hr[2] - 30.0 and pos.z > hr[1] + 30.0 and pos.z < hr[3] - 30.0


## Bauschritt 1 eines Entwurfs: Gelände (Berg, Hang mit Weinbergen) und Hochstraßen
static func build_step1(root: Node3D, track: Dictionary) -> void:
	if track.has("terrain_lay"):
		build_terrain(root, track)
		if track["terrain_lay"].get("vine", false):
			_vineyard(root, track)
	if track.has("hochstrassen"):
		_hochstrassen(root, track)
		for v in track["hochstrassen"]:
			if v.has("gleis_d"):
				_gleisfeld(root, track, v)


## Gleisfeld: Schotterbetten mit Schienen quer unter der Hochstraße, abgestellte Güterzüge, zwei Lichtmasten
static func _gleisfeld(root: Node3D, track: Dictionary, v: Dictionary) -> void:
	var curve: Curve3D = track["curve"]
	var f := Track.frame_at(curve, v["gleis_d"])
	var bs := Basis.looking_at(f["right"], Vector3.UP)  # -Z entlang der Gleise
	var o: Vector3 = f["pos"]
	var n := int(v["gleise"])
	var g := {}
	var ballast := Builder.mat(Color(0.17, 0.15, 0.13), 0.0, 0.95)
	var rail := Builder.mat(Color(0.55, 0.55, 0.57), 0.8, 0.35)
	var bed := Builder.mat(Color(0.1, 0.09, 0.08), 0.0, 1.0)
	var lampm := Builder.mat(Color(1.0, 0.7, 0.35), 0.0, 0.4, Color(1.0, 0.62, 0.28), 4.0)
	var pole := Builder.mat(Color(0.3, 0.31, 0.32), 0.6, 0.5)
	var cols := [Color(0.33, 0.12, 0.08), Color(0.1, 0.17, 0.3), Color(0.28, 0.28, 0.3), Color(0.12, 0.2, 0.14), Color(0.42, 0.3, 0.1)]
	var wag := []
	for c in cols:
		wag.append(Builder.mat(c, 0.2, 0.7))
	var rng := RandomNumberGenerator.new()
	rng.seed = 4711
	var L := GLEIS_LEN * 2.0
	Track._part(g, bed, Builder.box(Vector3(n * GLEIS_STEP + 6.0, 0.06, L + 8.0)), Transform3D(bs.rotated(Vector3.UP, 0.0), o + Vector3(0, 0.03, 0)))
	for k in n:
		var x := (k - (n - 1) / 2.0) * GLEIS_STEP
		var c: Vector3 = o + f["fwd"] * x
		Track._part(g, ballast, Builder.box(Vector3(3.2, 0.32, L)), Transform3D(bs, c + Vector3(0, 0.16, 0)))
		for sd in [-0.72, 0.72]:
			Track._part(g, rail, Builder.box(Vector3(0.09, 0.16, L)), Transform3D(bs, c + f["fwd"] * sd + Vector3(0, 0.4, 0)))
		# abgestellter Güterzug auf einigen Gleisen
		if k % 3 != 1 and rng.randf() < 0.75:
			var cnt := rng.randi_range(2, 6)
			var z0 := rng.randf_range(-L / 2.0 + 4.0, -L / 2.0 + 40.0)
			var tall := rng.randf_range(3.4, 3.9)
			for w in cnt:
				var zc := z0 + w * 15.0 + 7.0
				if zc > L / 2.0 - 8.0:
					break
				var q: Vector3 = c + f["right"] * zc
				Track._part(g, wag[rng.randi() % wag.size()], Builder.box(Vector3(2.9, tall - 1.0, 13.6)), Transform3D(bs, q + Vector3(0, 1.0 + (tall - 1.0) / 2.0 + 0.32, 0)))
				Track._part(g, bed, Builder.box(Vector3(2.4, 0.9, 12.0)), Transform3D(bs, q + Vector3(0, 0.32 + 0.6, 0)))
	# Lichtmasten an beiden Enden, natriumgelb
	for sd in [-1.0, 1.0]:
		var mp: Vector3 = o + f["right"] * sd * (GLEIS_LEN - 6.0) + f["fwd"] * ((n / 2.0) * GLEIS_STEP + 3.0)
		Track._part(g, pole, Builder.box(Vector3(0.5, 22.0, 0.5)), Transform3D(Basis(), mp + Vector3(0, 11.0, 0)))
		Track._part(g, lampm, Builder.box(Vector3(3.0, 0.8, 1.2)), Transform3D(bs, mp + Vector3(0, 22.2, 0)))
		var l := OmniLight3D.new()
		l.light_color = Color(1.0, 0.68, 0.35)
		l.light_energy = 2.5
		l.omni_range = 55.0
		l.position = mp + Vector3(0, 20.0, 0) - f["fwd"] * 6.0
		root.add_child(l)
	var node := Node3D.new()
	node.name = "Gleisfeld"
	root.add_child(node)
	Track._bake(node, g)


## Hochstraßen, Brücken, Parkdecks unter der erhöhten Hauptstraße (statt der Grasböschung): Betonplatte unter Fahrbahn
## und Gehweg, Pfeilerpaare alle gut 25 m (nicht auf Nebenstraßen, die darunter durchführen), "cable": zwei Pylone mit
## Schrägseilen, "deck": geschlossenes Parkhaus mit offenen Geschossen bis zum Boden
static func _hochstrassen(root: Node3D, track: Dictionary) -> void:
	var curve: Curve3D = track["curve"]
	var conc := Builder.mat(Color(0.46, 0.46, 0.47), 0.0, 0.85, Color(0.46, 0.46, 0.47), 0.05)
	var dark := Builder.mat(Color(0.03, 0.03, 0.035), 0.0, 0.9)
	var strip := Builder.mat(Color(1.0, 0.75, 0.4), 0.0, 0.4, Color(1.0, 0.7, 0.35), 2.0)
	var steel := Builder.mat(Color(0.75, 0.76, 0.78), 0.5, 0.4, Color(0.75, 0.76, 0.78), 0.1)
	var red := Builder.mat(Color(1.0, 0.1, 0.05), 0.0, 0.3, Color(1.0, 0.08, 0.04), 5.0)
	for v in track["hochstrassen"]:
		var g := {}
		var style: String = v["style"]
		var d: float = v["from"]
		var last_pier := -1e9
		var tops := []  # [d, Höhe] für die Pylone
		while d < v["to"]:
			var f := Track.frame_at(curve, d + 1.5)
			var y: float = f["y"]
			if y < 0.6:
				d += 3.0
				continue
			var bf := Basis.looking_at(f["fwd"], Vector3.UP)
			var half: float = Track.hw(track, d) + Track.WALK + 0.5
			var c: Vector3 = f["pos"] + Vector3(0, y, 0)
			tops.append([d, y])
			if style == "deck":
				var hh := y - 0.25
				Track._part(g, conc, Builder.box(Vector3(half * 2.0, hh, 3.05)), Transform3D(bf, f["pos"] + Vector3(0, hh / 2.0, 0)))
				var lv := 0
				while lv * 3.2 + 2.4 < hh:
					for sd in [-1.0, 1.0]:
						var q: Vector3 = f["pos"] + f["right"] * sd * (half + 0.02) + Vector3(0, lv * 3.2 + 1.5, 0)
						Track._part(g, dark, Builder.box(Vector3(0.06, 1.5, 3.06)), Transform3D(bf, q))
					lv += 1
			else:
				Track._part(g, conc, Builder.box(Vector3(half * 2.0, 1.4, 3.05)), Transform3D(bf, c + Vector3(0, -0.9, 0)))
				for sd in [-1.0, 1.0]:
					Track._part(g, strip, Builder.box(Vector3(0.05, 0.12, 3.05)), Transform3D(bf, c + f["right"] * sd * (half + 0.03) + Vector3(0, -0.6, 0)))
				if d - last_pier > 26.0 and y > 2.5 and (not v.has("gleis_d") or absf(d - v["gleis_d"]) > v["gleis_half"] + 1.0):
					var ok := true
					var piers := []
					for sd in [-1.0, 1.0]:
						var q: Vector3 = f["pos"] + f["right"] * sd * (Track.hw(track, d) - 2.0)
						if Track._branch_clearance(track, q) < 3.0:
							ok = false
						piers.append(q)
					if ok:
						for q in piers:
							Track._part(g, conc, Builder.box(Vector3(1.8, y - 1.5, 1.8)), Transform3D(bf, q + Vector3(0, (y - 1.5) / 2.0, 0)))
						Track._part(g, conc, Builder.box(Vector3(half * 2.0 - 4.0, 1.2, 2.2)), Transform3D(bf, f["pos"] + Vector3(0, y - 2.2, 0)))
						last_pier = d
			d += 3.0
		if style == "cable" and tops.size() > 10:
			# Pylone bei einem und zwei Dritteln, Schrägseile fächerförmig zur Plattenkante
			for frac in [0.33, 0.67]:
				var k := int(tops.size() * frac)
				var dp: float = tops[k][0]
				var yp: float = tops[k][1]
				var fp := Track.frame_at(curve, dp)
				var bp := Basis.looking_at(fp["fwd"], Vector3.UP)
				var half2: float = Track.hw(track, dp) + Track.WALK + 2.0
				var top_h := yp + 48.0
				for sd in [-1.0, 1.0]:
					var foot: Vector3 = fp["pos"] + fp["right"] * sd * half2
					var head: Vector3 = fp["pos"] + fp["right"] * sd * 2.5 + Vector3(0, top_h, 0)
					var mid := (foot + head) / 2.0
					var leg := head - foot
					Track._part(g, steel, Builder.box(Vector3(2.0, leg.length(), 2.4)), Transform3D(_beam_basis(leg), mid))
				Track._part(g, steel, Builder.box(Vector3(6.0, 2.0, 2.4)), Transform3D(bp, fp["pos"] + Vector3(0, top_h - 1.0, 0)))
				Track._part(g, red, Builder.box(Vector3(0.8, 0.8, 0.8)), Transform3D(bp, fp["pos"] + Vector3(0, top_h + 0.6, 0)))
				for j in range(-9, 10):
					if j == 0:
						continue
					var dc: float = dp + j * 7.0
					if dc < v["from"] or dc > v["to"]:
						continue
					var fc := Track.frame_at(curve, dc)
					for sd in [-1.0, 1.0]:
						var a: Vector3 = fp["pos"] + fp["right"] * sd * 2.8 + Vector3(0, top_h - 4.0 - absf(j) * 1.6, 0)
						var b: Vector3 = fc["pos"] + fc["right"] * sd * (Track.hw(track, dc) + Track.WALK + 0.3) + Vector3(0, float(fc["y"]) + 1.0, 0)
						var cab := b - a
						Track._part(g, steel, Builder.box(Vector3(0.18, cab.length(), 0.18)), Transform3D(_beam_basis(cab), (a + b) / 2.0))
		var n := Node3D.new()
		n.name = "Hochstrasse"
		root.add_child(n)
		Track._bake(n, g)
		if v["name"] != "" and tops.size() > 4:
			var dm: float = tops[tops.size() / 3][0]
			var fm := Track.frame_at(curve, dm)
			for sd in [-1.0, 1.0]:
				var l := Label3D.new()
				l.text = v["name"]
				l.font_size = 96
				l.pixel_size = 0.03
				l.modulate = Color(0.4, 0.8, 1.0) * 2.0
				l.shaded = false
				l.double_sided = false
				var half: float = Track.hw(track, dm) + Track.WALK + 0.65
				l.transform = Transform3D(Basis.looking_at(-fm["right"] * sd, Vector3.UP), fm["pos"] + fm["right"] * sd * half + Vector3(0, float(fm["y"]) * 0.5, 0))
				root.add_child(l)


## Basis, deren y-Achse entlang v zeigt (für Balken und Seile als gestreckte Quader)
static func _beam_basis(v: Vector3) -> Basis:
	var y := v.normalized()
	var x := Vector3.UP.cross(y)
	if x.length() < 0.01:
		x = Vector3.RIGHT
	x = x.normalized()
	var z := x.cross(y).normalized()
	return Basis(x, y, z)


## Weinberg (Stuttgart): Rebzeilen den Hang hinunter (je Gitterzelle zwei, 2,5 m auseinander), Trockenmauern als
## Terrassen alle 5 m Höhe quer zum Hang, ein paar Weinberghäuschen mit Licht. Nur auf mäßig steilen Hängen abseits der
## Straßen; nachts dunkelgrün, die Mauern heller.
static func _vineyard(root: Node3D, track: Dictionary) -> void:
	var t: Dictionary = track["terrain"]
	var o: Vector2 = t["o"]
	var nx: int = t["nx"]
	var nz: int = t["nz"]
	var h: PackedFloat32Array = t["h"]
	var nrm: PackedVector3Array = t["n"]
	var near: PackedFloat32Array = t["near"]
	var rng := RandomNumberGenerator.new()
	rng.seed = 30300
	var rows := []
	var row_cols := []
	var walls := []
	var huts := []
	for j in range(1, nz - 1):
		for i in range(1, nx - 1):
			var idx := j * nx + i
			var y := h[idx]
			var nv := nrm[idx]
			if y < 1.5 or near[idx] < 4.0 or nv.y < 0.7 or nv.y > 0.985:
				continue
			var p := Vector3(o.x + i * CELL, 0.0, o.y + j * CELL)
			if _on_pad(track, p, 3.0):
				continue
			var fall := Vector3(nv.x, 0.0, nv.z).normalized()  # bergab
			var across := Vector3(-fall.z, 0.0, fall.x)
			var bs := Basis.looking_at(fall, Vector3.UP)
			for k in [-1.25, 1.25]:
				var q: Vector3 = p + across * float(k)
				q.y = terrain_h(track, q)
				rows.append(Transform3D(bs * Basis.from_scale(Vector3(0.5, 1.05, 4.7)), q + Vector3(0, 0.5, 0)))
				row_cols.append(Color(0.05, 0.11, 0.035) * rng.randf_range(0.8, 1.2))
			# Terrasse: die 5-m-Höhenlinie läuft durch die Zelle
			var hmin := minf(minf(h[idx], h[idx + 1]), minf(h[idx + nx], h[idx + nx + 1]))
			var hmax := maxf(maxf(h[idx], h[idx + 1]), maxf(h[idx + nx], h[idx + nx + 1]))
			if floor(hmin / 5.0) != floor(hmax / 5.0):
				var wq := p + Vector3(CELL * 0.5, 0.0, CELL * 0.5)
				wq.y = terrain_h(track, wq)
				walls.append(Transform3D(Basis.looking_at(across, Vector3.UP) * Basis.from_scale(Vector3(0.7, 1.5, CELL + 0.4)), wq + Vector3(0, 0.4, 0)))
			if rng.randf() < 0.004:
				huts.append(Vector3(p.x, terrain_h(track, p), p.z))
	if not rows.is_empty():
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.use_colors = true
		mm.mesh = Builder.box(Vector3.ONE)
		mm.instance_count = rows.size()
		for k in rows.size():
			mm.set_instance_transform(k, rows[k])
			mm.set_instance_color(k, row_cols[k])
		var mi := MultiMeshInstance3D.new()
		mi.name = "Rebzeilen"
		mi.multimesh = mm
		var m := Builder.mat(Color(1, 1, 1), 0.0, 0.95)
		m.vertex_color_use_as_albedo = true
		mi.material_override = m
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		mi.visibility_range_end = 900.0
		root.add_child(mi)
	Track._multi(root, Builder.box(Vector3.ONE), Builder.mat(Color(0.34, 0.31, 0.26), 0.0, 0.9), walls)
	var g := {}
	var stone := Builder.mat(Color(0.5, 0.46, 0.38), 0.0, 0.9)
	var tile := Builder.mat(Color(0.36, 0.13, 0.08), 0.0, 0.8)
	var warm := Builder.mat(Color(1.0, 0.8, 0.5), 0.0, 0.4, Color(1.0, 0.75, 0.4), 3.0)
	for q in huts:
		Track._part(g, stone, Builder.box(Vector3(3.2, 2.8, 3.2)), Transform3D(Basis(), q + Vector3(0, 1.2, 0)))
		Track._part(g, tile, Builder.tapered_box(Vector2(3.8, 3.8), Vector2(0.4, 3.8), 1.8, 0.0), Transform3D(Basis(), q + Vector3(0, 2.6, 0)))
		Track._part(g, warm, Builder.box(Vector3(0.7, 0.7, 3.25)), Transform3D(Basis(), q + Vector3(0, 1.6, 0)))
		var l := OmniLight3D.new()
		l.light_color = Color(1.0, 0.75, 0.45)
		l.light_energy = 0.8
		l.omni_range = 9.0
		l.position = q + Vector3(0, 2.2, 0)
		root.add_child(l)
	if not g.is_empty():
		Track._bake(root, g)


## Bauschritt 1: Plätze planen, Gitter rechnen, Berg als Mesh (in Kacheln, damit nur Sichtbares gezeichnet wird),
## Wald darauf, Felstunnel
static func build_terrain(root: Node3D, track: Dictionary) -> void:
	_plan_pads(track)
	_plan_terrain(track)
	var t: Dictionary = track["terrain"]
	var o: Vector2 = t["o"]
	var nx: int = t["nx"]
	var nz: int = t["nz"]
	var h: PackedFloat32Array = t["h"]
	var nrm := PackedVector3Array()
	nrm.resize(nx * nz)
	for j in nz:
		for i in nx:
			var hl := h[j * nx + maxi(i - 1, 0)]
			var hr := h[j * nx + mini(i + 1, nx - 1)]
			var hd := h[maxi(j - 1, 0) * nx + i]
			var hu := h[mini(j + 1, nz - 1) * nx + i]
			nrm[j * nx + i] = Vector3(hl - hr, 2.0 * CELL, hd - hu).normalized()
	t["n"] = nrm
	var chunk := 36
	var cj := 0
	while cj < nz - 1:
		var ci := 0
		while ci < nx - 1:
			var st := SurfaceTool.new()
			st.begin(Mesh.PRIMITIVE_TRIANGLES)
			var any := false
			for j in range(cj, mini(cj + chunk, nz - 1)):
				for i in range(ci, mini(ci + chunk, nx - 1)):
					var a := j * nx + i
					var b := a + 1
					var c := a + nx
					var e := c + 1
					for tri in [[a, e, b], [a, c, e]]:
						if maxf(h[tri[0]], maxf(h[tri[1]], h[tri[2]])) < -0.25:
							continue
						any = true
						for v in tri:
							st.set_normal(nrm[v])
							st.add_vertex(Vector3(o.x + (v % nx) * CELL, h[v], o.y + (v / nx) * CELL))
			if any:
				var mi := MeshInstance3D.new()
				mi.name = "Berg"
				mi.mesh = st.commit()
				mi.material_override = material(track["terrain_lay"].get("vine", false))
				mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				root.add_child(mi)
			ci += chunk
		cj += chunk
	_forest(root, track)
	for tn in track["tunnels"]:
		if tn.get("rock", false):
			# Portale dort, wo der Fels die Röhre ganz deckt; davor und dahinter liegt die Straße im Felseinschnitt (sonst
			# stand die Röhre an beiden Enden gut 15 m frei)
			var curve: Curve3D = track["curve"]
			var a: float = tn["from"]
			var b: float = tn["to"]
			var covered := func(dd: float) -> bool:
				var f := Track.frame_at(curve, dd)
				return terrain_h(track, f["pos"]) >= float(f["y"]) + ROCK_TUN_H + 1.5
			while a < b - 20.0 and not covered.call(a):
				a += 1.0
			while b > a + 20.0 and not covered.call(b):
				b -= 1.0
			tn["from"] = a - 2.0
			tn["to"] = b + 2.0
			tn["r0"] = tn["from"]
			tn["r1"] = tn["to"]
			_rock_tunnel(root, track, tn)


## Aussichtspunkt außen an der Gipfelkehre und Platz vor dem Gasthof: ebene Flächen für das Gitter
static func _plan_pads(track: Dictionary) -> void:
	var lay: Dictionary = track["terrain_lay"]
	var curve: Curve3D = track["curve"]
	var pads := []
	if lay.has("view"):
		# Aussichtsbucht auf dem Bankett außen an der Gipfelkehre (dort stehen keine Bäume der Landschaft, der Blick geht
		# über die Wipfel am Hang darunter ins Tal)
		var d: float = track["ctrl_offs"][lay["view"]]
		var fa := Track.frame_at(curve, d - 12.0)
		var fb := Track.frame_at(curve, d + 12.0)
		var turn := (fa["fwd"] as Vector3).signed_angle_to(fb["fwd"], Vector3.UP)  # > 0: Linkskurve, außen rechts
		track["viewpoint"] = {"d": d, "side": 1.0 if turn > 0.0 else -1.0}
	if lay.has("inn"):
		var ip: Array = lay["inn"]
		var q := Vector3(ip[0], 0.0, ip[1])
		var d := curve.get_closest_offset(q)
		var f := Track.frame_at(curve, d)
		pads.append({"kind": "inn", "c": Vector2(ip[0], ip[1]), "u": Vector2(cos(ip[2]), sin(ip[2])), "hu": 20.0, "hv": 14.0,
			"y": float(f["y"]), "d": d, "rot": float(ip[2])})
	# Burg oder Schloss am Hang einer Stadt (Heidelberg, Nürnberg): ebene Terrasse auf fester Höhe, dort kein Wald
	for lm in lay.get("landmarks", []):
		if lm.has("pad"):
			var pd: Array = lm["pad"]
			pads.append({"kind": "terrace", "c": Vector2(lm["x"], lm["z"]), "u": Vector2(1, 0), "hu": float(pd[0]),
				"hv": float(pd[1]), "y": float(pd[2])})
	track["pads"] = pads


## Wald auf dem Berg: Fichten (Harz) auf allen nicht zu steilen Hängen, nicht auf Straße, Bankett, Plätzen; dichter
## mit dem Waldrauschen. Eigener Zufall.
static func _forest(root: Node3D, track: Dictionary) -> void:
	var t: Dictionary = track["terrain"]
	var o: Vector2 = t["o"]
	var nx: int = t["nx"]
	var nz: int = t["nz"]
	var h: PackedFloat32Array = t["h"]
	var nrm: PackedVector3Array = t["n"]
	var near: PackedFloat32Array = t["near"]
	var rng := RandomNumberGenerator.new()
	rng.seed = 120700
	var fn := FastNoiseLite.new()
	fn.seed = 77
	fn.frequency = 1.0 / 90.0
	var xfs := []
	var cols := []
	for j in range(1, nz - 1):
		for i in range(1, nx - 1):
			var idx := j * nx + i
			var y := h[idx]
			if y < 1.0 or near[idx] < 3.5 or near[idx] > 1e8 and y < 3.0:
				continue
			if nrm[idx].y < 0.8:
				continue  # Fels
			if track["terrain_lay"].get("vine", false) and y < 32.0 and nrm[idx].y < 0.985:
				continue  # Weinberg: Reben am Hang, Wald nur oben auf der Kuppe
			var dens := (0.16 + 0.3 * clampf(fn.get_noise_2d(o.x + i * CELL, o.y + j * CELL) + 0.2, 0.0, 1.0)) * float(track["terrain_lay"].get("trees", 1.0))
			if rng.randf() > dens:
				continue
			var p := Vector3(o.x + (i + rng.randf_range(-0.45, 0.45)) * CELL, 0.0, o.y + (j + rng.randf_range(-0.45, 0.45)) * CELL)
			if _on_pad(track, p, 4.0):
				continue
			p.y = terrain_h(track, p) - 0.2
			var s := rng.randf_range(0.7, 1.3)
			xfs.append(Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(s, s * rng.randf_range(0.9, 1.25), s)), p))
			cols.append(Color(0.06, 0.15, 0.07) * rng.randf_range(0.75, 1.2))
	if xfs.is_empty():
		return
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = _spruce_mesh()
	mm.instance_count = xfs.size()
	for k in xfs.size():
		mm.set_instance_transform(k, xfs[k])
		mm.set_instance_color(k, cols[k])
	var mi := MultiMeshInstance3D.new()
	mi.name = "Bergwald"
	mi.multimesh = mm
	var m := Builder.mat(Color(1, 1, 1), 0.0, 0.9)
	m.vertex_color_use_as_albedo = true
	mi.material_override = m
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mi.visibility_range_end = 1600.0
	root.add_child(mi)


static func _on_pad(track: Dictionary, p: Vector3, margin: float) -> bool:
	for pad in track.get("pads", []):
		var c: Vector2 = pad["c"]
		var u: Vector2 = pad["u"]
		var w := Vector2(p.x, p.z) - c
		if absf(w.dot(u)) < float(pad["hu"]) + margin and absf(w.dot(Vector2(-u.y, u.x))) < float(pad["hv"]) + margin:
			return true
	return false


## Fichte: Stamm und drei gestufte Kegel (Farbe je Baum über die Instanzfarbe)
static func _spruce_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var segs := 7
	var trunk := Color(0.55, 0.4, 0.3)
	_cone(st, 0.0, 2.2, 0.28, 0.2, segs, trunk)
	_cone(st, 1.6, 6.0, 2.6, 0.0, segs, Color(1, 1, 1))
	_cone(st, 4.4, 8.6, 1.9, 0.0, segs, Color(1.05, 1.08, 1.05))
	_cone(st, 6.8, 10.8, 1.2, 0.0, segs, Color(1.1, 1.15, 1.1))
	st.generate_normals()
	return st.commit()


static func _cone(st: SurfaceTool, y0: float, y1: float, r0: float, r1: float, segs: int, col: Color) -> void:
	for k in segs:
		var a0 := TAU * k / segs
		var a1 := TAU * (k + 1) / segs
		var b0 := Vector3(cos(a0) * r0, y0, sin(a0) * r0)
		var b1 := Vector3(cos(a1) * r0, y0, sin(a1) * r0)
		var t0 := Vector3(cos(a0) * r1, y1, sin(a0) * r1)
		var t1 := Vector3(cos(a1) * r1, y1, sin(a1) * r1)
		for v in [b0, t1, b1, b0, t0, t1]:
			st.set_color(col)
			st.add_vertex(v)
		# Boden des Kegels (von unten sieht man sonst hinein)
		for v in [Vector3(0, y0, 0), b1, b0]:
			st.set_color(col * 0.6)
			st.add_vertex(v)


# --- Felstunnel ---------------------------------------------------------------------------------------------------------

## Felstunnel: Spritzbeton-Gewölbe (senkrechte Wände, flacher Bogen), Natriumlicht, Portale aus Granitquadern mit Namen.
## Die Fahrbahn liegt auf ihrer Höhe (kein Trog), die Bande der Strecke läuft durch (Kollision).
static func _rock_tunnel(root: Node3D, track: Dictionary, tn: Dictionary) -> void:
	var curve: Curve3D = track["curve"]
	var a: float = tn["from"]
	var b: float = tn["to"]
	var shot := Builder.mat(Color(0.3, 0.29, 0.27), 0.0, 0.95)
	shot.cull_mode = BaseMaterial3D.CULL_DISABLED
	var lamp_c := Color(1.0, 0.62, 0.28)
	var lamp_m := Builder.mat(lamp_c, 0.0, 0.3, lamp_c, 6.0)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Querschnitt: senkrechte Wände bis 5,2 m, darüber ein flacher Bogen bis zur Scheitelhöhe ROCK_TUN_H
	var segs := 8
	var prev := []
	var d := a - 1.0
	while d <= b + 1.0:
		var f := Track.frame_at(curve, d)
		var w: float = Track.hw(track, d) + 1.4
		var c: Vector3 = f["pos"] + Vector3(0, f["y"], 0)
		var r: Vector3 = f["right"]
		var ring := []
		# linke Wand unten -> oben, Bogen, rechte Wand oben -> unten
		ring.append(c - r * w + Vector3(0, -0.3, 0))
		ring.append(c - r * w + Vector3(0, 5.2, 0))
		for k in range(1, segs):
			var ang := PI * k / segs
			ring.append(c - r * (w * cos(ang)) + Vector3(0, 5.2 + (ROCK_TUN_H - 5.2) * sin(ang), 0))
		ring.append(c + r * w + Vector3(0, 5.2, 0))
		ring.append(c + r * w + Vector3(0, -0.3, 0))
		if not prev.is_empty():
			for k in ring.size() - 1:
				for v in [prev[k], ring[k], ring[k + 1], prev[k], ring[k + 1], prev[k + 1]]:
					st.add_vertex(v)
		prev = ring
		d += 3.0
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.name = "Felstunnel"
	mi.mesh = st.commit()
	mi.material_override = shot
	root.add_child(mi)
	# Leuchten an der Decke, Licht
	var lamps := []
	d = a + 4.0
	var side := 1.0
	while d < b - 2.0:
		var f := Track.frame_at(curve, d)
		var bs := Basis.looking_at(f["fwd"], Vector3.UP)
		lamps.append(Transform3D(bs, f["pos"] + Vector3(0, f["y"] + ROCK_TUN_H - 0.25, 0)))
		if int((d - a) / 6.0) % 3 == 0:
			var l := OmniLight3D.new()
			l.light_color = lamp_c
			l.light_energy = 1.6
			l.omni_range = 16.0
			l.omni_attenuation = 1.0
			l.position = f["pos"] + f["right"] * side * 4.0 + Vector3(0, f["y"] + ROCK_TUN_H - 1.2, 0)
			root.add_child(l)
			side = -side
		track["pools"].append([f["pos"].x, f["pos"].z, Track.hw(track, d) + 1.0, lamp_c * 0.3])
		d += 6.0
	Track._multi(root, Builder.box(Vector3(0.5, 0.15, 3.2)), lamp_m, lamps)
	# Portale: Granitquader um die Öffnung, Name über der Einfahrt
	var stone := Builder.mat(Color(0.36, 0.34, 0.31), 0.0, 0.9)
	var dark := Builder.mat(Color(0.12, 0.12, 0.12), 0.0, 0.9)
	for end in 2:
		var dp: float = a if end == 0 else b
		var f := Track.frame_at(curve, dp)
		var out: Vector3 = -f["fwd"] if end == 0 else f["fwd"]
		var pn := Node3D.new()
		pn.transform = Transform3D(Basis.looking_at(-out, Vector3.UP), f["pos"] + Vector3(0, f["y"], 0))  # +Z aus dem Tunnel
		root.add_child(pn)
		var g := {}
		var w: float = Track.hw(track, dp) + 1.4
		var ph := ROCK_TUN_H + 5.0
		for s in [-1.0, 1.0]:
			Track._part(g, stone, Builder.box(Vector3(6.0, ph, 3.0)), Transform3D(Basis(), Vector3(s * (w + 3.0), ph / 2.0 - 0.3, -0.8)))
			Track._part(g, stone, Builder.box(Vector3(10.0, ph - 3.0, 2.5)), Transform3D(Basis(), Vector3(s * (w + 10.0), (ph - 3.0) / 2.0 - 0.3, -1.2)))
		Track._part(g, stone, Builder.box(Vector3(w * 2.0 + 12.0, ph - ROCK_TUN_H, 3.0)), Transform3D(Basis(), Vector3(0, ROCK_TUN_H + (ph - ROCK_TUN_H) / 2.0 - 0.3, -0.8)))
		Track._part(g, dark, Builder.box(Vector3(w * 2.0 + 0.4, 0.5, 0.3)), Transform3D(Basis(), Vector3(0, ROCK_TUN_H - 0.4, 0.75)))
		Track._bake(pn, g)
		var l := Label3D.new()
		l.text = tn["name"]
		l.font_size = 96
		l.pixel_size = 0.02
		l.modulate = Color(1.0, 0.85, 0.55) * 1.6
		l.shaded = false
		l.double_sided = false
		l.position = Vector3(0, ROCK_TUN_H + 2.2, 0.75)
		pn.add_child(l)
		var fl := OmniLight3D.new()
		fl.light_color = Color(1.0, 0.85, 0.6)
		fl.light_energy = 2.0
		fl.omni_range = 18.0
		fl.position = Vector3(0, ROCK_TUN_H + 3.0, 5.0)
		pn.add_child(fl)


# --- Banden der Bergstraße ----------------------------------------------------------------------------------------------

## Statt der rot-weißen Betonbande der Stadt-Drifts: talseits verzinkte Leitplanke auf Pfosten, bergseits eine graue
## Betonleitwand (fester Rand vor der Felswand), Leitpfosten mit Rückstrahlern, Reifenstapel außen in den Kehren,
## wenige Sponsorentafeln an der Planke und Flutlicht nur talseits (bergseits stünde es im Fels). Kollision wie bei
## jedem Drift-Kurs: durchgehende Wand am Bandenrand (hw + 0,4 m), Lücken an den Ausfahrten.
static func barriers(root: Node3D, track: Dictionary, rng: RandomNumberGenerator) -> void:
	var curve: Curve3D = track["curve"]
	var length: float = track["length"]
	var walls := StaticBody3D.new()
	walls.name = "WallsBarrier"
	root.add_child(walls)
	var steel := Builder.mat(Color(0.62, 0.64, 0.66), 0.55, 0.4)
	steel.cull_mode = BaseMaterial3D.CULL_DISABLED
	var post_m := Builder.mat(Color(0.45, 0.46, 0.48), 0.5, 0.5)
	var concrete := Builder.mat(Color(0.52, 0.52, 0.5), 0.0, 0.85)
	concrete.cull_mode = BaseMaterial3D.CULL_DISABLED
	var tire := Builder.mat(Color(0.04, 0.04, 0.045), 0.0, 0.9)
	var white := Builder.mat(Color(0.85, 0.85, 0.82), 0.0, 0.6)
	var blk := Builder.mat(Color(0.03, 0.03, 0.03), 0.0, 0.7)
	var refl := Builder.mat(Color(1.0, 0.5, 0.1), 0.0, 0.3, Color(1.0, 0.45, 0.1), 2.5)
	var rail := SurfaceTool.new()
	rail.begin(Mesh.PRIMITIVE_TRIANGLES)
	var wall := SurfaceTool.new()
	wall.begin(Mesh.PRIMITIVE_TRIANGLES)
	var posts := []
	var tires := []
	var delis := []
	var deli_refl := []
	var gaps := []
	for key in ["world_exit", "world_exit2"]:
		var ex: Dictionary = track[key]
		if not ex.is_empty():
			gaps.append([ex["d"], "r" if (Track.frame_at(curve, ex["d"])["right"] as Vector3).dot(ex["dir"]) > 0.0 else "l"])
	var valley_at := func(f: Dictionary, sd: float, d: float) -> bool:
		var q: Vector3 = f["pos"] + f["right"] * sd * (Track.hw(track, d) + Track.WALK + 4.0)
		return terrain_h(track, q) < float(f["y"]) - 0.8
	var d := 0.0
	var prev := {}
	var k := 0
	while d <= length:
		var f := Track.frame_at(curve, d)
		var b := Track.hw(track, d) + 0.4
		var up := Vector3(0.0, float(f["y"]), 0.0)
		var cur := {"l": f["pos"] - f["right"] * b + up, "r": f["pos"] + f["right"] * b + up, "d": d,
			"vl": valley_at.call(f, -1.0, d), "vr": valley_at.call(f, 1.0, d), "dir": f["right"]}
		var tun := in_rock_tunnel(track, d, 2.0)
		if not prev.is_empty():
			for sd in ["l", "r"]:
				var in_gap := false
				for g in gaps:
					if sd == g[1] and Track._loop_dist(track, d - 1.5, g[0]) < Track.RAMP_HALF + Track.WALK + 2.0:
						in_gap = true
				if in_gap:
					continue
				Track._wall_shape(walls, prev[sd], cur[sd])
				if tun:
					continue
				var sgn := -1.0 if sd == "l" else 1.0
				var valley: bool = cur["v" + sd] or prev["v" + sd]
				var o0: Vector3 = prev["dir"] * sgn * 0.12
				var o1: Vector3 = cur["dir"] * sgn * 0.12
				if valley:
					# Leitplanke: Band 0,55–0,9 m, leicht nach außen versetzt, oben eine Kante
					Track._wall_quad(rail, prev[sd] + o0 + Vector3(0, 0.55, 0), cur[sd] + o1 + Vector3(0, 0.55, 0),
						prev[sd].y + 0.9, cur[sd].y + 0.9, sd == "l")
					if k % 2 == 0:
						posts.append(Transform3D(Basis.looking_at(cur["dir"], Vector3.UP), cur[sd] + o1 * 2.2 + Vector3(0, 0.4, 0)))
				else:
					# Betonleitwand 0,8 m (Fuß breiter): Vorderseite, Krone
					Track._wall_quad(wall, prev[sd] - o0, cur[sd] - o1, prev[sd].y + 0.8, cur[sd].y + 0.8, sd == "l")
					Track._strip(wall, prev[sd] - o0 + Vector3(0, 0.8, 0), prev[sd] + o0 * 2.0 + Vector3(0, 0.8, 0),
						cur[sd] - o1 + Vector3(0, 0.8, 0), cur[sd] + o1 * 2.0 + Vector3(0, 0.8, 0), 0.0, 0.0)
		# Leitpfosten am Bankett, alle 24 m je Seite
		if k % 8 == 0 and not tun:
			for sgn in [-1.0, 1.0]:
				var q: Vector3 = f["pos"] + f["right"] * sgn * (Track.hw(track, d) + Track.WALK - 0.4) + up
				var bs := Basis.looking_at(f["right"] * -sgn, Vector3.UP)
				delis.append(Transform3D(bs, q + Vector3(0, 0.55, 0)))
				deli_refl.append(Transform3D(bs, q + Vector3(0, 0.95, 0) + f["right"] * -sgn * 0.07))
		# Reifenstapel außen in engen Kurven (Kollision als Polster vor der Bande)
		var f2 := Track.frame_at(curve, d + 12.0)
		var bend := (f["fwd"] as Vector3).signed_angle_to(f2["fwd"], Vector3.UP)
		var wide := (Track.frame_at(curve, d - 20.0)["fwd"] as Vector3).signed_angle_to(Track.frame_at(curve, d + 20.0)["fwd"], Vector3.UP)
		if absf(wide) < 1.3:
			bend = 0.0  # Reifenstapel nur in Kehren (in den Schlangenlinien fuhr man frontal hinein)
		var near_gap := false
		for g in gaps:
			if Track._loop_dist(track, d, g[0]) <= Track.RAMP_HALF + Track.WALK + 4.0:
				near_gap = true
		if absf(bend) > 0.3 and not near_gap and not tun:
			var out := -1.0 if bend > 0.0 else 1.0
			for j in 3:
				tires.append(Transform3D(Basis(), f["pos"] + up + f["right"] * out * (b - 0.6) + Vector3(0, 0.2 + j * 0.38, 0)))
			var tcs := CollisionShape3D.new()
			var tbs := BoxShape3D.new()
			tbs.size = Vector3(0.9, 1.3, 3.1)
			tcs.shape = tbs
			tcs.transform = Transform3D(Basis.looking_at(f["fwd"], Vector3.UP), f["pos"] + up + f["right"] * out * (b - 0.6) + Vector3(0, 0.65, 0))
			walls.add_child(tcs)
		prev = cur
		k += 1
		d += 3.0
	var mi := MeshInstance3D.new()
	mi.mesh = rail.commit()
	mi.material_override = steel
	root.add_child(mi)
	wall.generate_normals()
	var wi := MeshInstance3D.new()
	wi.mesh = wall.commit()
	wi.material_override = concrete
	root.add_child(wi)
	Track._multi(root, Builder.box(Vector3(0.12, 0.85, 0.16)), post_m, posts)
	var tm := CylinderMesh.new()
	tm.top_radius = 0.42
	tm.bottom_radius = 0.42
	tm.height = 0.36
	tm.radial_segments = 10
	Track._multi(root, tm, tire, tires)
	Track._multi(root, Builder.box(Vector3(0.12, 1.1, 0.12)), white, delis)
	Track._multi(root, Builder.box(Vector3(0.13, 0.08, 0.02)), refl, deli_refl)
	var bands := []
	for x in delis:
		bands.append(Transform3D(x.basis, x.origin + Vector3(0, 0.33, 0)))
	Track._multi(root, Builder.box(Vector3(0.125, 0.22, 0.125)), blk, bands)
	# Sponsorentafeln an der Planke (alle 70 m, nur talseits) und Flutlicht talseits (alle gut 90 m)
	var brands := ["DRIFTKÖNIGE", "NITROWERK", "KAIZEN", "TURBOSTARK", "RADIO VOLLGAS", "BROCKENBRÄU", "SAKURA", "RONIN", "REIFENWERK"]
	var dd := 30.0
	var i := 0
	var last_light := -1e9
	while dd < length - 10.0:
		if in_rock_tunnel(track, dd, 12.0):
			dd += 35.0
			continue
		var f := Track.frame_at(curve, dd)
		for sd in [-1.0, 1.0]:
			var in_gap := false
			for g in gaps:
				if ("l" if sd < 0.0 else "r") == g[1] and Track._loop_dist(track, dd, g[0]) < Track.RAMP_HALF + Track.WALK + 5.0:
					in_gap = true
			if in_gap or not valley_at.call(f, sd, dd):
				continue
			if i % 2 == 0:
				var bb := Track.hw(track, dd) + 0.25
				var n := Node3D.new()
				n.transform = Transform3D(Basis.looking_at(f["right"] * sd, Vector3.UP), f["pos"] + f["right"] * sd * bb + Vector3(0, f["y"], 0))
				root.add_child(n)
				var col: Color = Track.NEON[(i + int(sd)) % Track.NEON.size()]
				Builder._add(n, Builder.box(Vector3(4.0, 0.6, 0.06)), Builder.mat(Color(0.05, 0.05, 0.07), 0.2, 0.5, col, 0.35), Vector3(0, 1.25, 0))
				var l := Label3D.new()
				l.text = brands[(i * 3 + int(sd + 1.0)) % brands.size()]
				l.font_size = 40
				l.pixel_size = 0.011
				l.modulate = Color(col.r * 2.2, col.g * 2.2, col.b * 2.2)
				l.shaded = false
				l.double_sided = false
				l.position = Vector3(0, 1.25, 0.05)
				n.add_child(l)
			if dd - last_light > 88.0:
				var fp: Vector3 = f["pos"] + f["right"] * sd * (Track.hw(track, dd) + Track.WALK + 1.2) + Vector3(0, f["y"], 0)
				Builder._add(root, Builder.box(Vector3(0.45, 14.0, 0.45)), Builder.mat(Color(0.3, 0.3, 0.32), 0.6, 0.4), fp + Vector3(0, 7.0, 0))
				Builder._add(root, Builder.box(Vector3(2.6, 1.4, 0.4)), Builder.mat(Color(1, 1, 1), 0.0, 0.3, Color(0.95, 0.97, 1.0), 8.0), fp + Vector3(0, 14.2, 0)).basis = Basis.looking_at(-f["right"] * sd, Vector3.UP)
				var light := OmniLight3D.new()
				light.light_color = Color(0.9, 0.95, 1.0)
				light.light_energy = 2.2
				light.omni_range = 30.0
				light.position = fp + Vector3(0, 12.0, 0) - f["right"] * sd * 4.0
				root.add_child(light)
				last_light = dd
			break
		i += 1
		dd += 35.0


# --- Wahrzeichen am Berg ------------------------------------------------------------------------------------------------

## Aussichtspunkt (Plattform mit Geländer, Bänke, Münzfernrohr, Tafel, Gipfelkreuz), Berggasthof mit Licht in den
## Fenstern, Sendeturm auf der Klippe, Granitklippen im Wald. Gibt belegte Flächen zurück (wie _build_landmarks).
static func landmarks(root: Node3D, track: Dictionary, rng: RandomNumberGenerator) -> Array:
	var lay: Dictionary = track["mountain"]
	var occupied := []
	var wood := Builder.mat(Color(0.32, 0.2, 0.11), 0.0, 0.85)
	var iron := Builder.mat(Color(0.1, 0.1, 0.11), 0.6, 0.45)
	var stone := Builder.mat(Color(0.4, 0.38, 0.34), 0.0, 0.9)
	var paving := Builder.mat(Color(0.3, 0.29, 0.27), 0.0, 0.9)
	var warm := Builder.mat(Color(1.0, 0.8, 0.5), 0.0, 0.4, Color(1.0, 0.75, 0.4), 3.0)
	if track.has("viewpoint"):
		_viewpoint(root, track, lay, wood, iron)
	for pad in track.get("pads", []):
		var c: Vector2 = pad["c"]
		var u: Vector2 = pad["u"]
		var y: float = pad["y"]
		var bs := Basis.looking_at(Vector3(u.x, 0, u.y), Vector3.UP)  # -Z entlang u
		var n := Node3D.new()
		n.transform = Transform3D(bs, Vector3(c.x, y, c.y))
		root.add_child(n)
		var g := {}
		var hu: float = pad["hu"]
		var hv: float = pad["hv"]
		if pad["kind"] == "inn":
			# Berggasthof: Natursteinsockel, Holz darüber, steiles Dach, warmes Licht in den Fenstern, Parkplatz
			Track._part(g, paving, Builder.box(Vector3(hv * 2.0, 0.3, hu * 2.0)), Transform3D(Basis(), Vector3(0, -0.1, 0)))
			Track._part(g, stone, Builder.box(Vector3(11.0, 3.2, 17.0)), Transform3D(Basis(), Vector3(-2.0, 1.6, 0)))
			Track._part(g, wood, Builder.box(Vector3(11.0, 3.4, 17.0)), Transform3D(Basis(), Vector3(-2.0, 4.9, 0)))
			var roof := Builder.tapered_box(Vector2(12.6, 18.6), Vector2(0.6, 18.6), 4.8, 0.0)
			Track._part(g, Builder.mat(Color(0.16, 0.1, 0.08), 0.0, 0.85), roof, Transform3D(Basis(), Vector3(-2.0, 6.6, 0)))
			for wz in [-6.0, -3.0, 0.0, 3.0, 6.0]:
				for wy in [1.7, 5.0]:
					Track._part(g, warm, Builder.box(Vector3(11.1, 1.1, 1.3)), Transform3D(Basis(), Vector3(-2.0, wy, wz)))
			Track._part(g, wood, Builder.box(Vector3(0.3, 2.4, 2.0)), Transform3D(Basis(), Vector3(3.6, 1.2, 0)))
			Track._bake(n, g)
			var sl := Track._label(n, lay.get("inn_name", "BERGGASTHOF"), Color(1.0, 0.85, 0.55), 64, Vector3(3.7, 3.9, 0), 1.6)
			sl.rotation_degrees.y = 90.0
			sl.pixel_size = 0.016
			for lz in [-5.0, 5.0]:
				var l := OmniLight3D.new()
				l.light_color = Color(1.0, 0.75, 0.45)
				l.light_energy = 1.5
				l.omni_range = 16.0
				l.position = Vector3(6.0, 3.0, lz)
				n.add_child(l)
		occupied.append({"pos": Vector3(c.x, 0, c.y), "r": maxf(hu, hv) + 4.0})
	if lay.has("tower"):
		var tp: Array = lay["tower"]
		var q := Vector3(tp[0], 0.0, tp[1])
		q.y = terrain_h(track, q)
		_tower(root, q)
	for rk in lay.get("rocks", []):
		var q := Vector3(rk[0], 0.0, rk[1])
		var th := terrain_h(track, q)
		if th < 1.0:
			continue
		q.y = th
		_klippe(root, q, float(rk[2]), rng)
	return occupied


## Aussichtsbucht auf dem Bankett außen an der Gipfelkehre: Holzgeländer an der Kante zum Hang, zwei Bänke mit Blick
## ins Tal, Münzfernrohr, Gipfelkreuz, Laterne; davor ein braunes Hinweisschild für die, die heraufkommen
static func _viewpoint(root: Node3D, track: Dictionary, lay: Dictionary, wood: Material, iron: Material) -> void:
	var vp: Dictionary = track["viewpoint"]
	var curve: Curve3D = track["curve"]
	var d0: float = vp["d"]
	var side: float = vp["side"]
	var g := {}
	var rails := SurfaceTool.new()
	rails.begin(Mesh.PRIMITIVE_TRIANGLES)
	var wood2 := (wood as BaseMaterial3D).duplicate() as BaseMaterial3D
	wood2.cull_mode = BaseMaterial3D.CULL_DISABLED
	var at := func(dd: float, lat: float, up: float) -> Vector3:
		var f := Track.frame_at(curve, dd)
		return f["pos"] + f["right"] * side * lat + Vector3(0, float(f["y"]) + Track.CURB_H + up, 0)
	var edge: float = Track.hw(track, d0) + Track.WALK - 0.25
	var dd := d0 - 20.0
	var prev := Vector3.INF
	while dd <= d0 + 20.0:
		var q: Vector3 = at.call(dd, edge, 0.0)
		Track._part(g, wood, Builder.box(Vector3(0.14, 1.1, 0.14)), Transform3D(Basis(), q + Vector3(0, 0.55, 0)))
		if prev.is_finite():
			for hb in [[0.55, 0.68], [0.95, 1.08]]:
				Track._wall_quad(rails, prev + Vector3(0, hb[0], 0), q + Vector3(0, hb[0], 0), prev.y + hb[1], q.y + hb[1], false)
		prev = q
		dd += 2.0
	var outward := func(dd2: float) -> Basis:
		var f := Track.frame_at(curve, dd2)
		return Basis.looking_at(f["right"] * side, Vector3.UP)  # -Z zeigt ins Tal
	for bd in [-8.0, 6.0]:
		var bs: Basis = outward.call(d0 + bd)
		var q: Vector3 = at.call(d0 + bd, edge - 1.8, 0.0)
		Track._part(g, wood, Builder.box(Vector3(2.2, 0.08, 0.5)), Transform3D(bs, q + Vector3(0, 0.48, 0)))
		Track._part(g, wood, Builder.box(Vector3(2.2, 0.5, 0.08)), Transform3D(bs, q + bs.z * 0.28 + Vector3(0, 0.78, 0)))
		for sx in [-0.9, 0.9]:
			Track._part(g, iron, Builder.box(Vector3(0.08, 0.45, 0.42)), Transform3D(bs, q + bs.x * sx + Vector3(0, 0.22, 0)))
	var tb: Basis = outward.call(d0 - 1.0)
	var tq: Vector3 = at.call(d0 - 1.0, edge - 0.9, 0.0)
	Track._part(g, iron, Builder.box(Vector3(0.14, 1.1, 0.14)), Transform3D(tb, tq + Vector3(0, 0.55, 0)))
	Track._part(g, iron, Builder.box(Vector3(0.3, 0.3, 0.6)), Transform3D(tb * Basis(Vector3.RIGHT, 0.25), tq + Vector3(0, 1.25, 0)))
	var cq: Vector3 = at.call(d0 + 15.0, edge - 1.0, 0.0)
	var cb: Basis = outward.call(d0 + 15.0)
	Track._part(g, wood, Builder.box(Vector3(0.3, 5.5, 0.3)), Transform3D(cb, cq + Vector3(0, 2.75, 0)))
	Track._part(g, wood, Builder.box(Vector3(2.4, 0.28, 0.28)), Transform3D(cb, cq + Vector3(0, 4.2, 0)))
	Track._bake(root, g)
	var mi := MeshInstance3D.new()
	mi.mesh = rails.commit()
	mi.material_override = wood2
	root.add_child(mi)
	var lamp_q: Vector3 = at.call(d0 + 2.0, edge - 0.6, 0.0)
	var l := OmniLight3D.new()
	l.light_color = Color(1.0, 0.82, 0.55)
	l.light_energy = 1.6
	l.omni_range = 20.0
	l.position = lamp_q + Vector3(0, 4.0, 0)
	root.add_child(l)
	Builder._add(root, Builder.box(Vector3(0.12, 4.0, 0.12)), iron, lamp_q + Vector3(0, 2.0, 0))
	Builder._add(root, Builder.box(Vector3(0.4, 0.45, 0.4)), Builder.mat(Color(1.0, 0.85, 0.6), 0.0, 0.4, Color(1.0, 0.8, 0.5), 3.0), lamp_q + Vector3(0, 4.1, 0))
	# braunes Hinweisschild (touristisches Ziel) 70 m vorher am Bankett, zum Heraufkommenden gedreht
	var sd := d0 - 70.0
	var sf := Track.frame_at(curve, sd)
	var sq: Vector3 = sf["pos"] + sf["right"] * side * (Track.hw(track, sd) + 2.2) + Vector3(0, float(sf["y"]) + Track.CURB_H, 0)
	var sn := Node3D.new()
	sn.transform = Transform3D(Basis.looking_at(sf["fwd"], Vector3.UP), sq)  # +Z zeigt dem Fahrer entgegen
	root.add_child(sn)
	var brown := Builder.mat(Color(0.36, 0.2, 0.1), 0.0, 0.6, Color(0.36, 0.2, 0.1), 0.25)
	for px in [-1.4, 1.4]:
		Builder._add(sn, Builder.box(Vector3(0.1, 2.6, 0.1)), iron, Vector3(px, 1.3, -0.05))
	Builder._add(sn, Builder.box(Vector3(3.6, 1.2, 0.08)), brown, Vector3(0, 2.6, 0))
	var sl := Label3D.new()
	sl.text = lay.get("view_name", "AUSSICHT")
	sl.font_size = 44
	sl.pixel_size = 0.0115
	sl.modulate = Color(1, 1, 1) * 1.3
	sl.shaded = false
	sl.double_sided = false
	sl.position = Vector3(0, 2.6, 0.05)
	sn.add_child(sl)


## Sendeturm (wie auf dem Brocken): Betonschaft, Kanzel, Antennenmast mit roten Gefahrenfeuern; von weit zu sehen
static func _tower(root: Node3D, base: Vector3) -> void:
	var g := {}
	var conc := Builder.mat(Color(0.62, 0.62, 0.6), 0.0, 0.8, Color(0.62, 0.62, 0.6), 0.08)
	var red := Builder.mat(Color(1.0, 0.1, 0.05), 0.0, 0.3, Color(1.0, 0.08, 0.04), 6.0)
	var shaft := CylinderMesh.new()
	shaft.top_radius = 2.2
	shaft.bottom_radius = 3.6
	shaft.height = 46.0
	shaft.radial_segments = 14
	Track._part(g, conc, shaft, Transform3D(Basis(), base + Vector3(0, 23.0, 0)))
	var pod := CylinderMesh.new()
	pod.top_radius = 6.0
	pod.bottom_radius = 5.0
	pod.height = 7.0
	pod.radial_segments = 16
	Track._part(g, conc, pod, Transform3D(Basis(), base + Vector3(0, 40.0, 0)))
	var mast := CylinderMesh.new()
	mast.top_radius = 0.35
	mast.bottom_radius = 0.9
	mast.height = 30.0
	mast.radial_segments = 8
	Track._part(g, Builder.mat(Color(0.75, 0.25, 0.2), 0.3, 0.5), mast, Transform3D(Basis(), base + Vector3(0, 61.0, 0)))
	for hy in [44.0, 58.0, 76.0]:
		Track._part(g, red, Builder.box(Vector3(0.9, 0.6, 0.9)), Transform3D(Basis(), base + Vector3(0, hy, 0)))
	Track._part(g, conc, Builder.box(Vector3(22.0, 6.0, 14.0)), Transform3D(Basis(), base + Vector3(14.0, 2.5, 4.0)))
	var mi := Node3D.new()
	mi.name = "Sendeturm"
	root.add_child(mi)
	Track._bake(mi, g)
	var l := OmniLight3D.new()
	l.light_color = Color(1.0, 0.15, 0.08)
	l.light_energy = 3.0
	l.omni_range = 26.0
	l.position = base + Vector3(0, 77.0, 0)
	root.add_child(l)


## Granitklippe: aufgetürmte, gerundete Blöcke (Wollsackverwitterung wie im Harz)
static func _klippe(root: Node3D, base: Vector3, s: float, rng: RandomNumberGenerator) -> void:
	var g := {}
	var gran := Builder.mat(Color(0.42, 0.4, 0.36), 0.0, 0.92)
	var y := -1.0
	var stack := rng.randi_range(3, 5)
	for k in stack:
		var w := rng.randf_range(4.5, 7.0) * s * (1.0 - k * 0.13)
		var hh := rng.randf_range(2.4, 3.6) * s
		var bx := Builder.rbox(Vector3(w, hh, w * rng.randf_range(0.7, 1.0)), minf(hh, w) * 0.35)
		var off := Vector3(rng.randf_range(-0.8, 0.8), 0, rng.randf_range(-0.8, 0.8)) * s
		Track._part(g, gran, bx, Transform3D(Basis(Vector3.UP, rng.randf() * TAU).rotated(Vector3.FORWARD, rng.randf_range(-0.08, 0.08)), base + off + Vector3(0, y + hh / 2.0, 0)))
		y += hh * 0.92
	var n := Node3D.new()
	n.name = "Klippe"
	root.add_child(n)
	Track._bake(n, g)


# --- Städte: Querstraßen und Wahrzeichen --------------------------------------------------------------------------------

## Open World: Querstraßen durch das Innere eines Rundkurses (von Stützpunkt a zu b), zweispurig wie die Nebenstraßen
## ("lane"): Häuser an beiden Seiten, Laternen, Wände; wo sich zwei kreuzen, bleibt die Kreuzung offen
## (track_builder._other_branch_clear). So ist eine Stadt in der freien Fahrt keine bloße Runde mehr. Im Rennen gibt es
## sie nicht (die Strecke ist abgesperrt wie bisher).
static func plan_cross(track: Dictionary, race: Dictionary) -> void:
	var lay: Dictionary = LAYOUTS[race["layout"]]
	if not lay.has("cross") or not track.has("ctrl_offs"):
		return
	var curve: Curve3D = track["curve"]
	var offs: PackedFloat32Array = track["ctrl_offs"]
	var cen := Vector3.ZERO
	var bp := curve.get_baked_points()
	for q in bp:
		cen += q
	cen /= maxf(bp.size(), 1)
	for cr in lay["cross"]:
		var da: float = offs[cr[0]]
		var db: float = offs[cr[1]]
		var ok := true
		for dm in [da, db]:
			var dd: float = dm - 30.0
			while dd <= dm + 30.0:
				var why := ""
				if Track._trough_at(track, dd) != 0:
					why = "trog"
				elif not Track.tunnel_at(track, dd, 10.0).is_empty():
					why = "tunnel"
				elif not Track.bridge_at(track, dd).is_empty():
					why = "bruecke"
				elif absf(Track.elev_at(curve, dd)) > 0.05:
					why = "hoehe"
				elif Track.median_at(track, dd) > 0.05:
					why = "median"
				elif track["crossing_d"] >= 0.0 and absf(dd - track["crossing_d"]) < 60.0:
					why = "bahn"
				if why != "" and ok:
					ok = false
					Track.lane_why["quer_mund_%d_%s" % [cr[0] if dm == da else cr[1], why]] = 1
				dd += 6.0
		if not ok:
			continue
		var fa := Track.frame_at(curve, da)
		var fb := Track.frame_at(curve, db)
		var pa: Vector3 = fa["pos"]
		var pb: Vector3 = fb["pos"]
		# Seite: nach innen (Rundkurse) oder vorgegeben [a, b, k, Seite bei a, Seite bei b] (+1 rechts, -1 links; Sprints)
		var ia: Vector3 = fa["right"] * (float(cr[3]) if cr.size() > 4 else signf((cen - pa).dot(fa["right"])))
		var ib: Vector3 = fb["right"] * (float(cr[4]) if cr.size() > 4 else signf((cen - pb).dot(fb["right"])))
		var span := pa.distance_to(pb)
		var c := Curve3D.new()
		c.bake_interval = 1.0
		c.add_point(pa, Vector3.ZERO, ia * span * float(cr[2] if cr.size() > 2 else 0.4))
		c.add_point(pb, ib * span * float(cr[2] if cr.size() > 2 else 0.4), Vector3.ZERO)
		var L := c.get_baked_length()
		var dc := 36.0  # die ersten Meter liegen an der Einmündung zwangsläufig nah an der Hauptstraße
		var why := ""
		while dc < L - 36.0 and why == "":
			var q := c.sample_baked(dc)
			if Track._main_clearance(track, q) < Track.LANE_HALF + Track.WALK + 10.0:
				why = "strasse"
			elif Track._in_river(track, q, 10.0) or Track._in_lake(track, q, 10.0):
				why = "wasser"
			elif Track._rail_clearance(track, q) < 14.0:
				why = "bahn"
			elif Track._keepout_hit(track, q, Basis(), Track.LANE_HALF + 3.0, Track.LANE_HALF + 3.0):
				why = "keepout"
			if why != "":
				Track.lane_why["quer_platz_%d_%s_%d" % [cr[0], why, int(dc)]] = 1
			dc += 6.0
		if why != "":
			continue
		track["paths"].append({"id": track["paths"].size(), "kind": "lane", "curve": c, "half_w": Track.LANE_HALF,
			"length": L, "from": da, "to": db, "closed": false, "side": 0.0, "cross": true})
		track["zones"].append({"from": da - 22.0, "to": da + 22.0})
		track["zones"].append({"from": db - 22.0, "to": db + 22.0})


## Zufällige Wahrzeichen (Kirche, Tankstelle, Krankenhaus, Stadion, Teich) zusätzlich zu den eigenen? Nur wenn der
## Entwurf keine eigenen hat oder sie ausdrücklich will ("random_landmarks")
static func random_landmarks(race: Dictionary) -> bool:
	var lay: Dictionary = LAYOUTS.get(race.get("layout", ""), {})
	return not lay.has("landmarks") or lay.get("random_landmarks", false)


## Wahrzeichen eines Stadt-Entwurfs an festen Stellen (wie bei den Orts-Strecken: track_builder._build_city_landmarks,
## rückt bei Bedarf von der Straße weg, hält Platz davor frei)
static func town_landmarks(root: Node3D, track: Dictionary, race: Dictionary) -> Array:
	var lay: Dictionary = LAYOUTS.get(race.get("layout", ""), {})
	if not lay.has("landmarks"):
		return []
	var curve: Curve3D = track["curve"]
	var rng := RandomNumberGenerator.new()
	rng.seed = int(race.get("seed", 0)) * 7 + 3
	var occ := []
	var rest := []
	for lm in lay["landmarks"]:
		var kind: String = lm["kind"]
		if kind == "arena":
			# Stadion mit Parkplatz zur nächsten Straße (track_builder._stadium), an fester Stelle
			var pos := Vector3(lm["x"], 0.0, lm["z"])
			var q := curve.get_closest_point(pos)
			var to_road := Vector3(q.x - pos.x, 0.0, q.z - pos.z).normalized()
			var n := Node3D.new()
			n.name = "Arena"
			n.transform = Transform3D(Basis.looking_at(to_road, Vector3.UP), pos)
			root.add_child(n)
			Track._stadium(n, float(lm.get("front", 100.0)), rng)
			track["stadium_d"] = curve.get_closest_offset(pos)
			occ.append({"pos": pos, "r": 70.0})
		elif lm.has("at"):
			# Tor über der Straße (Siegestor, Stadttor, Brückentor): Pfeiler neben dem Gehweg, Bogen über der Fahrbahn
			var d: float = track["ctrl_offs"][lm["at"]]
			var f := Track.frame_at(curve, d)
			var n := Node3D.new()
			n.name = kind
			n.transform = Transform3D(Basis.looking_at(f["fwd"], Vector3.UP), f["pos"] + Vector3(0, float(f["y"]), 0))
			root.add_child(n)
			var half: float = Track.hw(track, d) + Track.WALK + 0.8
			City.new(n).make(kind, {"hw": half, "name": lm.get("name", "")})
			for sd in [-1.0, 1.0]:
				occ.append({"pos": f["pos"] + f["right"] * sd * (half + 6.0), "r": 9.0})
			if kind == "stadttor":
				for sd in [-1.0, 1.0]:  # runder Torturm rechts, links ebenso frei (Fußabdruck in City.INFO)
					occ.append({"pos": f["pos"] + f["right"] * sd * (half + 11.5), "r": 10.5})
		else:
			rest.append(lm)
	for v in track.get("hochstrassen", []):
		occ.append_array(v.get("gleis_occ", []))
	for sm in lay.get("stadtmauer", []):
		occ.append_array(_stadtmauer(root, track, float(track["ctrl_offs"][sm[0]]), float(track["ctrl_offs"][sm[1]]), float(sm[2])))
	var keep: Dictionary = track["city"]
	track["city"] = {"landmarks": rest}
	var n0 := root.get_child_count()
	occ.append_array(Track._build_city_landmarks(root, track))
	track["city"] = keep
	# am Hang (Gelände des Entwurfs) auf dessen Höhe; "flip": Schauseite von der nächsten Straße weg (das Heidelberger
	# Schloss blickt auf Altstadt und Neckar, nicht auf die Straße am Hang dahinter)
	for k in range(n0, root.get_child_count()):
		var c := root.get_child(k)
		if not c is Node3D:
			continue
		if track.has("terrain"):
			var th := terrain_h(track, (c as Node3D).position)
			if th > 0.0:
				(c as Node3D).position.y = th - 0.3
		for lm in rest:
			if lm.get("flip", false) and String(c.name) == lm["kind"]:
				(c as Node3D).rotate_y(PI)
	return occ



## Stadtmauer (Nürnberg): Sandsteinmauer mit Zinnen und runden Türmen hinter einem Graben neben der Ringstraße, von d0
## bis d1 auf Seite side (+1 rechts, -1 links). Gibt die belegten Flächen zurück (dort keine Häuser).
static func _stadtmauer(root: Node3D, track: Dictionary, d0: float, d1: float, side: float) -> Array:
	var curve: Curve3D = track["curve"]
	var stone: Material = City.m("redsand")
	var grass := Builder.mat(Color(0.06, 0.11, 0.05), 0.0, 0.95)
	var roof: Material = City.m("tile")
	var g := {}
	var occ := []
	var d := d0
	var k := 0
	while d < d1:
		var f := Track.frame_at(curve, d)
		var bs := Basis.looking_at(f["fwd"], Vector3.UP)
		var edge: float = Track.hw(track, d) + Track.WALK
		var wp: Vector3 = f["pos"] + f["right"] * side * (edge + 15.0)
		var gp: Vector3 = f["pos"] + f["right"] * side * (edge + 7.5)
		# Lücke, wo eine Querstraße, Gasse oder Ausfahrt durch die Mauer führt
		var gate := false
		for p in track["paths"]:
			if p["id"] != 0:
				var pc: Curve3D = p["curve"]
				var r: float = float(p["half_w"]) + 5.0
				if pc.get_closest_point(wp).distance_to(wp) < r or pc.get_closest_point(gp).distance_to(gp) < r:
					gate = true
		if gate:
			d += 4.0
			k += 1
			continue
		Track._part(g, stone, Builder.box(Vector3(2.4, 9.0, 4.2)), Transform3D(bs, wp + Vector3(0, 4.5, 0)))
		Track._part(g, stone, Builder.box(Vector3(2.6, 1.2, 1.6)), Transform3D(bs, wp + Vector3(0, 9.6, 0)))
		Track._part(g, grass, Builder.box(Vector3(12.0, 0.1, 4.2)), Transform3D(bs, gp + Vector3(0, 0.05, 0)))
		if k % 2 == 1:
			occ.append({"pos": Vector3(gp.x, 0, gp.z), "r": 6.5})  # Graben: keine Häuser zwischen Ring und Mauer
		if k % 28 == 14:
			var tp: Vector3 = f["pos"] + f["right"] * side * (edge + 16.5)
			var cyl := CylinderMesh.new()
			cyl.top_radius = 5.0
			cyl.bottom_radius = 5.4
			cyl.height = 17.0
			cyl.radial_segments = 14
			Track._part(g, stone, cyl, Transform3D(Basis(), tp + Vector3(0, 8.5, 0)))
			var cone := CylinderMesh.new()
			cone.top_radius = 0.2
			cone.bottom_radius = 5.8
			cone.height = 7.0
			cone.radial_segments = 14
			Track._part(g, roof, cone, Transform3D(Basis(), tp + Vector3(0, 20.5, 0)))
			occ.append({"pos": Vector3(tp.x, 0, tp.z), "r": 8.0})
		if k % 2 == 0:
			occ.append({"pos": Vector3(wp.x, 0, wp.z), "r": 6.0})
		d += 4.0
		k += 1
	var n := Node3D.new()
	n.name = "Stadtmauer"
	root.add_child(n)
	Track._bake(n, g)
	return occ
